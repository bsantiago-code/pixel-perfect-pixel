# Copia este archivo a .env.local (ignorado por git) y completa los valores.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=portal_viaticos

# Puerto de la API (Express); Vite le reenvía /api en desarrollo
API_PORT=3001

# Llave para cifrar la contraseña SMTP guardada en la base (mínimo 16 caracteres).
# `npm run dev:all` la genera sola en .env.local si falta. Si cambia, hay que volver a capturar la contraseña SMTP.
APP_SECRET=

# ── Correo (SMTP) ───────────────────────────────────────────────────────────────────
# El servidor SMTP se configura en la pantalla Configuración o con `npm run smtp:configurar` (ver CLAUDE.md).
# La contraseña de aplicación NO se escribe aquí ni en git: se pasa solo al ejecutar el script.
#   PowerShell:  $env:SMTP_PASSWORD = "xxxx xxxx xxxx xxxx"; npm run smtp:configurar
#   bash:        SMTP_PASSWORD="xxxx xxxx xxxx xxxx" npm run smtp:configurar

# ── Archivos de comprobantes (XML/PDF/foto) ──────────────────────────────────────────
# db    = en la base de datos (por omisión, no requiere nada más)
# local = carpeta del servidor (o la carpeta que sincroniza Google Drive para escritorio / ruta de red)
# drive = Google Drive por API con una cuenta de servicio (ver docs/almacenamiento-google-drive.md)
STORAGE_DRIVER=db
STORAGE_LOCAL_DIR=
GDRIVE_CREDENTIALS_FILE=
GDRIVE_CREDENTIALS_JSON=
GDRIVE_ROOT_FOLDER_ID=
GDRIVE_IMPERSONATE=
